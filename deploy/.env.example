# Kopyala: cp deploy/.env.example deploy/.env   (deploy/.env repoya girmez)
# Değer üretmek için: openssl rand -hex 32

# Postgres şifresi (zorunlu)
POSTGRES_PASSWORD=

# API bearer token (zorunlu). Panelde bir kez: localStorage.setItem('jobscanner_token', '<bu değer>')
JOBSCANNER_API_TOKEN=

# Panelin dışarı açılacağı port
WEB_PORT=8080

# Ollama modeli (değiştirirsen: docker compose ... exec ollama ollama pull <model>)
LLM_MODEL=llama3.1

# Tarama aralığı (saat)
SCAN_INTERVAL_HOURS=8
