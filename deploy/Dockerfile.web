# JobScanner.Web — SPA build + nginx (statik servis + /api proxy). Build context: repo kökü
FROM node:22-alpine AS build
WORKDIR /web
COPY src/JobScanner.Web/package.json src/JobScanner.Web/package-lock.json ./
RUN npm ci
COPY src/JobScanner.Web/ ./
RUN npm run build

FROM nginx:stable-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
